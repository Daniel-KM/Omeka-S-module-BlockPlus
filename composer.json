{
    "name": "daniel-km/omeka-s-module-block-plus",
    "type": "omeka-s-module",
    "description": "Module for Omeka S: Add page models, groups of blocks and new blocks for editorial site pages (image gallery, D3 graph, mirror page, search form, showcase, exhibits, etc.) and resource pages (title, thumbnail, previous/next, etc.).",
    "keywords": [
        "Omeka S",
        "Omeka S module",
        "block",
        "page",
        "theme"
    ],
    "license": "CECILL-2.1",
    "homepage": "https://gitlab.com/Daniel-KM/Omeka-S-module-BlockPlus",
    "authors": [
        {
            "name": "Daniel Berthereau",
            "email": "Daniel.packagist@Berthereau.net"
        }
    ],
    "support": {
        "issues": "https://gitlab.com/Daniel-KM/Omeka-S-module-BlockPlus/-/work_items",
        "forum": "https://forum.omeka.org/"
    },
    "_require (not set until Omeka S merges PR #2432)": {
        "omeka/omeka-s": "^4.1",
        "daniel-km/omeka-s-module-common": "*"
    },
    "require": {
        "sempia/external-assets": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "BlockPlus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BlockPlusTest\\": "tests/BlockPlusTest/"
        }
    },
    "extra": {
        "installer-name": "BlockPlus",
        "external-assets": {
            "asset/vendor/thumbnail-grid-expanding-preview/": "https://gitlab.com/Daniel-KM/ThumbnailGridExpandingPreview/-/archive/0.3.0/ThumbnailGridExpandingPreview-0.3.0.tar.gz",
            "asset/vendor/d3/d3.min.js": "https://unpkg.com/d3@7.9.0/dist/d3.min.js",
            "asset/vendor/jcarousel/javascripts/jquery.jcarousel.min.js": "https://raw.githubusercontent.com/jsor/jcarousel/0.3.9/dist/jquery.jcarousel.min.js",
            "asset/vendor/jcarousel/javascripts/jcarousel.responsive.js": "https://raw.githubusercontent.com/jsor/jcarousel/0.3.9/examples/responsive/jcarousel.responsive.js",
            "asset/vendor/jcarousel/css/jcarousel.responsive.css": "https://raw.githubusercontent.com/jsor/jcarousel/0.3.9/examples/responsive/jcarousel.responsive.css",
            "asset/vendor/slick/": "https://github.com/kenwheeler/slick/archive/refs/tags/v2.0.1.tar.gz",
            "asset/vendor/jslists/": "https://github.com/TheTechy/jslists/archive/6184acf2b0b89223d5f6930ddeb8d690c9e9f940.tar.gz"
        }
    },
    "config": {
        "allow-plugins": {
            "sempia/external-assets": true
        }
    }
}
