<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\AbstractResourceEntityRepresentation $resource
 */

// This block must be used with the matching block collapsible-end. The button
// is outside of the content, so it remains visible when the content is hidden.

$plugins = $this->getHelperPluginManager();
$assetUrl = $plugins->get('assetUrl');
$translate = $plugins->get('translate');
$escapeAttr = $plugins->get('escapeHtmlAttr');

$this->headLink()
    ->appendStylesheet($assetUrl('css/block-plus.css', 'BlockPlus'));
$this->headScript()
    ->appendFile($assetUrl('js/block-plus.js', 'BlockPlus'), 'text/javascript', ['defer' => 'defer']);

$id = 'block-collapsible-' . $resource->id() . '-' . substr(md5(uniqid('', true)), 0, 6);
$labelExpand = $translate('Enlarge'); // @translate
$labelCollapse = $translate('Reduce'); // @translate
?>

<div class="block block-resource block-collapsible">
    <button type="button" class="block-collapsible-button" aria-expanded="true" aria-controls="<?= $id ?>" data-label-expand="<?= $escapeAttr($labelExpand) ?>" data-label-collapse="<?= $escapeAttr($labelCollapse) ?>"><?= $labelExpand ?></button>
    <div class="block-collapsible-content" id="<?= $id ?>">
