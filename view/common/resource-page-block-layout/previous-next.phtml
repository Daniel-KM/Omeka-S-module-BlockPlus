<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\AbstractResourceEntityRepresentation $resource
 * @var \Omeka\Api\Representation\AbstractResourceEntityRepresentation|null $previous
 * @var \Omeka\Api\Representation\AbstractResourceEntityRepresentation|null $next
 * @var bool $back
 * @var string $lastBrowseUrl
 * @var array $options Passed options.
 */

$plugins = $this->getHelperPluginManager();
$escapeAttr = $plugins->get('escapeHtmlAttr');
$translate = $plugins->get('translate');

$labelPrevious = $translate('Previous resource');
$labelNext = $translate('Next resource');
?>

<nav class="block resource-block block-previous-next" aria-label="<?= $escapeAttr($translate('Previous and next resources')) ?>">
    <?php if ($previous): ?>
    <a class="button previous-resource" href="<?= $escapeAttr($previous->siteUrl()) ?>" rel="prev" title="<?= $escapeAttr($labelPrevious) ?>" aria-label="<?= $escapeAttr($labelPrevious) ?>">&lt;</a>
    <?php else: ?>
    <span class="button previous-resource disabled" aria-hidden="true" style="color: gray;">&lt;</span>
    <?php endif; ?>
    <?php /* // Not configurable in resource page block.
    <?php if (!empty($back)): ?>
        <?php if ($lastBrowseUrl): ?>
        <a class="button back-to-search" href="<?= $escapeAttr($lastBrowseUrl) ?>" rel="search" title="<?= $escapeAttr($translate('Back to last search')) ?>" aria-label="<?= $escapeAttr($translate('Back to last search')) ?>">^</a>
        <?php endif; ?>
    <?php endif; ?>
    */ ?>
    <?php if ($next): ?>
    <a class="button next-resource" href="<?= $escapeAttr($next->siteUrl()) ?>" rel="next" title="<?= $escapeAttr($labelNext) ?>" aria-label="<?= $escapeAttr($labelNext) ?>">&gt;</a>
    <?php else: ?>
    <span class="button next-resource disabled" aria-hidden="true" style="color: gray;">&gt;</span>
    <?php endif; ?>
</nav>
